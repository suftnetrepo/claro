{
  "expo": {
    "name": "Claro",
    "slug": "claro",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#12162D"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.suftnet.claro",
      "buildNumber": "2",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Claro uses Face ID to keep your finances secure.",
        "NSCameraUsageDescription": "Claro uses the camera to scan receipts.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "appleTeamId": "ZQADUF26X5"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#22713F"
      },
      "package": "com.suftnet.claro",
      "versionCode": 2,
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "web": {
      "favicon": "./assets/icon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Claro uses Face ID to keep your finances secure."
        }
      ]
    ],
    "scheme": "claro",
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "1884029f-59f0-4982-bc07-0bb076a2fcbc"
      }
    },
    "owner": "kcmkcms"
  }
}
